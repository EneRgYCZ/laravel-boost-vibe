{
    "name": "energycz/laravel-boost-vibe",
    "type": "library",
    "homepage": "https://github.com/EneRgYCZ/laravel-boost-vibe",
    "autoload": {
        "psr-4": {
            "Energycz\\LaravelBoostVibe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Energycz\\LaravelBoostVibe\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Catalin Zaharia",
            "email": "catalin.zaharia2013@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/boost": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "mockery/mockery": "^1.6",
        "pestphp/pest": "^2.36"
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Energycz\\LaravelBoostVibe\\LaravelBoostVibeServiceProvider"
            ]
        }
    }
}